# MVP 后端环境配置模板
# 复制为 .env 后填写。.env 不入库；密钥只写在服务器环境或部署秘密管理里。
# 变量清单与含义见 docs/mvp/01_文件架构与职责.md 第 8.1 节。

# ── 应用模式 ──────────────────────────────────────────────────
# development / test / production
APP_ENV=development
# mock / real；默认 mock。real 必须显式启用，且具备密钥、价格与预算。
# 正式(production)模式下 real 调用失败不得静默退回 mock。
LLM_MODE=mock

# ── Django ────────────────────────────────────────────────────
# 正式环境必须显式提供随机密钥；留空时仅 development/test 允许临时生成。
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# 明确列出允许的主机名，不要用 *
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 正式站点 origin，按实际 HTTPS 地址填写
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 数据存储 ──────────────────────────────────────────────────
# 开发与集成测试必须锁定同一 PostgreSQL 主版本。
# 本机没有 PostgreSQL 时，development 可留空，settings 会回退到 .data/db.sqlite3 并打印警告。
DATABASE_URL=postgresql://review:review@127.0.0.1:5432/review_mvp
REDIS_URL=redis://127.0.0.1:6379/0
# 原文与产物的私有根目录；Web 与 worker 必须共享同一卷。不得指向源码目录或前端 public。
PRIVATE_STORAGE_ROOT=

# ── DeepSeek ──────────────────────────────────────────────────
# 只进入后端进程环境；绝不写入代码、前端变量或 API 响应。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_MODE=disabled

# ── 模型调用限制 ──────────────────────────────────────────────
LLM_REQUEST_TIMEOUT_SECONDS=120
# 包含最多一次输出格式修复，不另起不计数的修复重试
LLM_MAX_ATTEMPTS=3
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_OUTPUT_TOKENS=4096
# 部署级有效并发上限；增加 worker 不能绕过
LLM_MAX_CONCURRENCY=2

# ── 任务租约 ──────────────────────────────────────────────────
# 心跳必须显著小于租约
JOB_HEARTBEAT_SECONDS=10
JOB_LEASE_SECONDS=60

# ── 预算与计价（USD，十进制定点）──────────────────────────────
# 项目默认预算；零或未配置不得被解释为无限预算。
PROJECT_DEFAULT_BUDGET_USD=0
# 价目必须来自已核验的来源，并保留配置版本。
LLM_PRICE_INPUT_CACHE_HIT_PER_MILLION_USD=0
LLM_PRICE_INPUT_CACHE_MISS_PER_MILLION_USD=0
LLM_PRICE_OUTPUT_PER_MILLION_USD=0

# ── 其他 ──────────────────────────────────────────────────────
# arXiv 客户端标识所用联系信息
ARXIV_CONTACT=
LOG_LEVEL=INFO
# 前端公开构建变量，固定同域 /api/v1，不得包含任何密钥
VITE_API_BASE_URL=/api/v1
